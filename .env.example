# Local Docker Compose example values. Copy to .env when starting manually.
COMPOSE_PROJECT_NAME=rxcheck
DB_NAME=rxcheck_db
DB_USER=rxcheck_user
DB_PASSWORD=rxcheck_pwd
JWT_SECRET=change_me_to_a_long_random_string
API_KEY_SECRET=change_me_to_a_long_random_string
MINIO_ROOT_USER=rxcheck_minio
MINIO_ROOT_PASSWORD=rxcheck_minio_pwd
RATE_LIMIT_PER_SECOND=200
BACKEND_PORT=19945
DB_PORT=44018
REDIS_PORT=46318
MINIO_PORT=47020
